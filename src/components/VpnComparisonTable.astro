---
const cta = (p: string) => `/go/vpn?provider=${p}`;
const rows = [
  { name: 'CyberGhost', tag: 'Meilleur rapport qualité/prix', price: '2,19 €/mois', arg: 'Serveurs optimisés streaming (RTBF, RTS)', guarantee: '45 jours', provider: 'cyberghost', top: true },
  { name: 'NordVPN', tag: 'Débit maximal & 4K', price: '3,09 €/mois', arg: 'Serveurs ultra-rapides, sécurité maximale', guarantee: '30 jours', provider: 'nordvpn', top: false },
  { name: 'Surfshark', tag: 'Écrans illimités', price: '2,49 €/mois', arg: 'Parfait pour partager avec ses proches', guarantee: '30 jours', provider: 'surfshark', top: false },
];
---
<div class="grid gap-4 sm:grid-cols-3">
  {rows.map((v) => (
    <div class={`relative flex flex-col rounded-xl border p-5 ${v.top ? 'border-emerald-500/40 bg-emerald-950/20' : 'border-slate-800 bg-slate-900/80'}`}>
      {v.top && <span class="absolute -top-3 left-4 rounded bg-emerald-400 px-2 py-0.5 text-[10px] font-black uppercase text-emerald-950">Recommandé</span>}
      <p class="font-black text-white">{v.name}</p>
      <p class="text-xs font-semibold text-cyan-400">{v.tag}</p>
      <p class="mt-3 text-2xl font-black text-white">{v.price}</p>
      <p class="mt-1 flex-1 text-xs text-slate-400">{v.arg}<br />Garantie {v.guarantee}</p>
      <a href={cta(v.provider)} rel="nofollow sponsored noopener" target="_blank"
         class={`mt-4 rounded-lg px-4 py-2.5 text-center text-sm font-black ${v.top ? 'bg-gradient-to-r from-cyan-500 to-blue-600 text-white shadow-lg shadow-cyan-500/25' : 'border border-slate-700 text-slate-200 hover:bg-slate-800'}`}>
        Choisir {v.name} →
      </a>
    </div>
  ))}
</div>
