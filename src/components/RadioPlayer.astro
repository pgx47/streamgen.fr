---
// Lecteur radio FR : commentaires français sur image étrangère en clair.
const streams = [
  { name: 'RMC', url: 'https://audio.bfmtv.com/rmcradio.mp3' },
  { name: 'France Bleu', url: 'https://icecast.radiofrance.fr/francebleu-midfi.mp3' },
];
---
<div class="rounded-xl border border-slate-800 bg-slate-900/80 p-5">
  <p class="font-bold text-white">🎧 Image HD en clair + commentaires en français</p>
  <p class="mt-1 text-sm text-slate-400">La diffusion gratuite est en langue étrangère ? Lancez la radio officielle en parallèle — flux audio français gratuit.</p>
  <div class="mt-3 space-y-2">
    {streams.map((s) => (
      <div class="flex items-center gap-3">
        <span class="w-28 text-sm font-semibold text-slate-200">{s.name}</span>
        <audio controls preload="none" class="h-8 flex-1" src={s.url}></audio>
      </div>
    ))}
  </div>
</div>
