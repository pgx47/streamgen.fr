---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'matches'> }
const { entry } = Astro.props;
const d = entry.data;
const icons: Record<string, string> = { football: '⚽', 'formule-1': '🏎️', ufc: '🥊', motogp: '🏍️', tennis: '🎾', rugby: '🏉', cyclisme: '🚴', 'sports-hiver': '⛷️', combat: '🥊' };
const badge = {
  upcoming: 'bg-slate-800 text-slate-300',
  live: 'bg-rose-950 text-rose-300 animate-pulse',
  finished: 'bg-slate-800/60 text-slate-500',
}[d.status];
const isFight = ['ufc', 'combat'].includes(d.sport);
const t1 = { img: isFight ? (d.fighter1?.photo || d.homeTeamLogo) : d.homeTeamLogo, name: isFight ? (d.fighter1?.name || d.homeTeam) : d.homeTeam, flag: d.fighter1?.flag };
const t2 = { img: isFight ? (d.fighter2?.photo || d.awayTeamLogo) : d.awayTeamLogo, name: isFight ? (d.fighter2?.name || d.awayTeam) : d.awayTeam, flag: d.fighter2?.flag };
const initials = (n?: string) => (n ?? '?').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const free = [...new Map(d.freeBroadcasters.map((b) => [new URL(b.url).hostname, b])).values()];
const top = free[0];
const favicon = (u: string) => `https://www.google.com/s2/favicons?domain=${new URL(u).hostname}&sz=64`;
---
<a href={`/${d.sport}/${entry.id}/`}
   class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900 shadow-lg transition-all hover:border-cyan-500/50">
  <div class="flex items-center justify-between border-b border-zinc-800/80 px-4 py-2.5">
    <span class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-zinc-400">
      {icons[d.sport]} {d.competition}
    </span>
    <span class="ev-date rounded px-2 py-0.5 text-[10px] font-bold" data-iso={d.eventDate.toISOString()} data-status={d.status}></span>
  </div>

  <div class="flex items-center justify-between px-4 py-6">
    {[t1, t2].map((t) => (
      <div class="flex w-[38%] flex-col items-center gap-3">
        <div class="flex h-16 w-16 items-center justify-center">
          {t.img
            ? <img src={t.img} alt={t.name} class="h-16 w-16 object-contain drop-shadow-md" loading="lazy" />
            : <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-zinc-700 bg-zinc-800 text-sm font-black text-zinc-400">{t.flag || initials(t.name)}</span>}
        </div>
        {t.name && <span class="line-clamp-2 text-center text-sm font-bold leading-tight text-white">{t.name}</span>}
      </div>
    )).slice(0, 1)}
    <div class="flex w-[24%] items-center justify-center">
      <span class="text-xl font-black italic text-zinc-600">VS</span>
    </div>
    {[t1, t2].slice(1).map((t) => (
      <div class="flex w-[38%] flex-col items-center gap-3">
        <div class="flex h-16 w-16 items-center justify-center">
          {t.img
            ? <img src={t.img} alt={t.name} class="h-16 w-16 object-contain drop-shadow-md" loading="lazy" />
            : <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-zinc-700 bg-zinc-800 text-sm font-black text-zinc-400">{t.flag || initials(t.name)}</span>}
        </div>
        {t.name && <span class="line-clamp-2 text-center text-sm font-bold leading-tight text-white">{t.name}</span>}
      </div>
    ))}
  </div>

  {top && (
    <div class="mt-auto flex items-center justify-between border-t border-zinc-800 bg-zinc-950/50 px-4 py-3">
      <div class="flex items-center gap-2">
        <img src={favicon(top.url)} alt={top.name} class="h-5 w-auto rounded-sm bg-white/90 object-contain" loading="lazy" />
        <span class="text-xs font-semibold text-white">{top.name}</span>
        <span class="flex items-center gap-1 text-xs font-medium text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
          {d.status === 'finished' ? 'Replay' : 'En clair'}
        </span>
      </div>
      <span class="text-xs text-zinc-400 transition group-hover:text-cyan-300">Voir ↗</span>
    </div>
  )}
</a>
<script is:inline>
  document.querySelectorAll('.ev-date:not([data-run])').forEach((el) => {
    el.dataset.run = '1';
    const t = new Date(el.dataset.iso).getTime(), st = el.dataset.status;
    const fmt = new Date(el.dataset.iso);
    const tick = () => {
      const ms = t - Date.now();
      if (st === 'finished') { el.textContent = 'Terminé'; el.className += ' bg-slate-800/60 text-slate-500'; return; }
      if (ms <= 0 && ms > -3*36e5) { el.innerHTML = '🔴 Direct'; el.className = el.className.replace(/bg-\S+|text-\S+/g,'').trim() + ' rounded px-2 py-0.5 text-[10px] font-bold bg-rose-950 text-rose-300 animate-pulse'; return; }
      const lbl = fmt.toLocaleDateString('fr-FR',{day:'numeric',month:'short'}).toUpperCase() + ' · ' + fmt.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
      el.textContent = ms <= 0 ? lbl : lbl;
      el.className += ' bg-slate-800 text-slate-300';
      setTimeout(tick, 60000);
    };
    tick();
  });
</script>
