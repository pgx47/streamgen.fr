---
const TAG = import.meta.env.PUBLIC_AMAZON_TAG ?? 'streamgenfr-21';
// Images via le service officiel Amazon AdSystem (lien legal d'affiliation).
const img = (asin: string) =>
  `https://ws-eu.amazon-adsystem.com/widgets/q?_encoding=UTF8&MarketPlace=FR&ASIN=${asin}&ServiceVersion=20070822&ID=AsinImage&WS=1&tag=${TAG}&linkid=` ;
const items = [
  { name: 'Fire TV Stick 4K Max', asin: 'B0BW37QY2W', arg: "Apps VPN + chaînes étrangères en 2 clics sur ta TV" },
  { name: 'Boîtier Android TV (Xiaomi)', asin: 'B09PZZ7F9K', arg: "Décodeur 4K universel, Play Store complet" },
  { name: 'Câble HDMI 2.1 Ugreen', asin: 'B07ZJ8S8Y6', arg: "Connexion directe PC/Mac → TV sans perte" },
];
---
<div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5">
  <p class="font-bold text-white">📺 Regarder sur grand écran : le matériel recommandé</p>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {items.map((i) => (
      <a href={`https://www.amazon.fr/dp/${i.asin}?tag=${TAG}`} rel="nofollow sponsored noopener" target="_blank"
         class="flex flex-col rounded-xl border border-slate-800 bg-slate-900 p-4 transition hover:border-cyan-500/40">
        <span class="flex h-24 items-center justify-center bg-white/5 rounded-lg">
          <img src={img(i.asin)} alt={i.name} class="max-h-20 object-contain" loading="lazy"
               onerror="this.outerHTML='<span class=\\'text-3xl\\'>📦</span>'" />
        </span>
        <p class="mt-3 text-sm font-bold text-white">{i.name}</p>
        <p class="mt-1 flex-1 text-xs text-slate-500">{i.arg}</p>
        <p class="mt-2 text-xs font-bold text-amber-400">Voir sur Amazon →</p>
      </a>
    ))}
  </div>
  <p class="mt-3 text-[10px] text-slate-600">Liens affiliés Amazon — sans surcoût pour vous.</p>
</div>
