---
interface Fight { fight: string; category?: string; isMainCard: boolean }
interface Props { fights: Fight[] }
const { fights } = Astro.props;
const main = fights.filter((f) => f.isMainCard);
const prelims = fights.filter((f) => !f.isMainCard);
const split = (f: string) => {
  const m = f.split(/\s+vs\.?\s+/i);
  return { a: m[0] ?? f, b: m[1] ?? '' };
};
---
{(main.length || prelims.length) > 0 && (
  <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
    <h2 class="text-lg font-black text-white">Carte complète</h2>
    {main.length > 0 && (
      <div class="mt-4">
        <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-400">
          <span class="h-2 w-2 rounded-full bg-amber-400"></span> Main Card
        </p>
        <ul class="space-y-2.5">
          {main.map((f, i) => { const s = split(f.fight); return (
            <li class="flex items-center gap-3 rounded-lg border border-slate-800 bg-slate-900 px-4 py-3">
              {i === 0 && <span class="shrink-0 rounded bg-amber-400 px-1.5 py-0.5 text-[10px] font-black uppercase text-amber-950">Main</span>}
              {i === 1 && <span class="shrink-0 rounded bg-slate-700 px-1.5 py-0.5 text-[10px] font-black uppercase text-slate-300">Co-Main</span>}
              <span class="flex-1 text-sm">
                <span class="font-bold text-white">{s.a}</span>
                <span class="mx-2 text-xs text-slate-500">vs</span>
                <span class="font-bold text-white">{s.b}</span>
              </span>
              {f.category && <span class="shrink-0 text-xs text-slate-500">{f.category}</span>}
            </li>
          ); })}
        </ul>
      </div>
    )}
    {prelims.length > 0 && (
      <div class="mt-5">
        <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500">
          <span class="h-2 w-2 rounded-full bg-slate-500"></span> Préliminaires
        </p>
        <ul class="space-y-1.5">
          {prelims.map((f) => { const s = split(f.fight); return (
            <li class="flex items-center gap-3 rounded-lg bg-slate-900/50 px-4 py-2.5 text-sm text-slate-300">
              <span class="flex-1">
                <span class="font-semibold">{s.a}</span>
                <span class="mx-2 text-xs text-slate-600">vs</span>
                <span class="font-semibold">{s.b}</span>
              </span>
              {f.category && <span class="shrink-0 text-xs text-slate-500">{f.category}</span>}
            </li>
          ); })}
        </ul>
      </div>
    )}
  </section>
)}
