---
interface Props { schedule: { label: string; date: Date }[]; channel?: string }
const { schedule, channel } = Astro.props;
---
{schedule.length > 1 && (
  <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
    <h2 class="text-lg font-black text-white">Programme complet du week-end</h2>
    <div class="mt-3 divide-y divide-slate-800">
      {schedule.map((s) => (
        <div class="flex items-center gap-3 py-2 text-sm">
          <span class="w-44 font-semibold text-white">{s.label}</span>
          <span class="text-slate-400">
            {s.date.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' })} · {s.date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
          </span>
          {channel && <span class="ml-auto rounded bg-emerald-950 px-2 py-0.5 text-xs font-bold text-emerald-300">{channel}</span>}
        </div>
      ))}
    </div>
  </section>
)}
