---
interface Props {
  title: string;
  competition: string;
  sport: string;
  homeTeam?: string;
  awayTeam?: string;
  homeTeamLogo?: string;
  awayTeamLogo?: string;
  eventPoster?: string;
  eventDate: Date;
  status: 'upcoming' | 'live' | 'finished';
  score?: string;
  venue?: string;
  channel?: string;
  vpnServer?: string;
  fighter1?: { name: string; country?: string; flag?: string; record?: string; nickname?: string; ranking?: string; photo?: string };
  fighter2?: { name: string; country?: string; flag?: string; record?: string; nickname?: string; ranking?: string; photo?: string };
  weightClass?: string;
  titleFight?: boolean;
}
const { title, competition, sport, homeTeam, awayTeam, homeTeamLogo, awayTeamLogo, eventPoster, eventDate, status, score, venue, channel, vpnServer, fighter1, fighter2, weightClass, titleFight } = Astro.props;
const duel = fighter1 && fighter2;
const icons: Record<string, string> = { football: '⚽', 'formule-1': '🏎️', ufc: '🥊', motogp: '🏍️', tennis: '🎾', rugby: '🏉', cyclisme: '🚴', 'sports-hiver': '⛷️', combat: '🥊' };
const statusBadge = {
  upcoming: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30',
  live: 'bg-rose-500/15 text-rose-300 border-rose-500/30 animate-pulse',
  finished: 'bg-slate-700/40 text-slate-300 border-slate-600',
};
const statusLabel = { upcoming: 'À venir', live: 'EN DIRECT', finished: 'Terminé' };
---
<div class="relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/90 p-6 sm:p-8 shadow-2xl shadow-black/40">
  {eventPoster && (
    <div class="absolute inset-0 z-0">
      <img src={eventPoster} alt="" class="h-full w-full object-cover opacity-20 blur-sm mix-blend-luminosity" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/40 to-slate-900"></div>
    </div>
  )}

  <div class="relative z-10">
    <div class="flex flex-wrap items-center gap-3 mb-5">
      <span class="text-2xl">{icons[sport] ?? '🏆'}</span>
      <span class="text-sm font-semibold uppercase tracking-wider text-slate-400">{competition}</span>
      <span class={`ml-auto rounded-full border px-3 py-1 text-xs font-bold uppercase ${statusBadge[status]}`}>{statusLabel[status]}</span>
    </div>

    {duel ? (
      <div class="flex items-center justify-between gap-4 text-center">
        {[fighter1, fighter2].map((f, i) => (
          <div class="flex-1" key={f.name}>
            <div class="mx-auto mb-2 flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border border-slate-700/50 bg-slate-800/80 shadow-xl drop-shadow-lg sm:h-32 sm:w-32">
              <img
                src={f.photo || (i === 0 ? '/images/fighters/silhouette-red.svg' : '/images/fighters/silhouette-blue.svg')}
                alt={f.name}
                class="h-full w-full object-cover object-top drop-shadow-xl"
                loading="lazy" />
            </div>
            <p class="font-black text-white">{f.flag} {f.name}</p>
            {f.record && <p class="text-xs font-semibold text-slate-400">{f.record}</p>}
            {f.ranking && <p class="text-[11px] font-bold text-amber-400">{f.ranking}</p>}
          </div>
        ))}
        <div class="absolute left-1/2 top-16 -translate-x-1/2 px-2">
          <p class="text-3xl font-black text-slate-500">VS</p>
        </div>
      </div>
    ) : homeTeam && awayTeam ? (
      <div class="flex items-center justify-between gap-4 text-center">
        <div class="flex-1">
          <div class="mx-auto mb-2 flex h-24 w-24 items-center justify-center sm:h-36 sm:w-36">
            {homeTeamLogo
              ? <img src={homeTeamLogo} alt={homeTeam} class="h-full w-full object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.6)]" loading="lazy" />
              : <span class="text-4xl sm:text-5xl">{icons[sport] ?? '🏆'}</span>}
          </div>
          <p class="font-black text-white sm:text-lg">{homeTeam}</p>
        </div>
        <div class="px-4">
          {status === 'finished' && score
            ? <p class="text-4xl font-black text-white">{score}</p>
            : <p class="text-3xl font-black text-slate-500">VS</p>}
        </div>
        <div class="flex-1">
          <div class="mx-auto mb-2 flex h-24 w-24 items-center justify-center sm:h-36 sm:w-36">
            {awayTeamLogo
              ? <img src={awayTeamLogo} alt={awayTeam} class="h-full w-full object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.6)]" loading="lazy" />
              : <span class="text-4xl sm:text-5xl">{icons[sport] ?? '🏆'}</span>}
          </div>
          <p class="font-black text-white sm:text-lg">{awayTeam}</p>
        </div>
      </div>
    ) : (
      <h1 class="text-2xl sm:text-3xl font-black text-white">{title}</h1>
    )}

    {duel && (
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-center">
        {weightClass && <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-bold text-cyan-300">{weightClass}</span>}
        {titleFight && <span class="rounded-full border border-amber-500/40 bg-amber-950/50 px-3 py-1 text-xs font-black text-amber-300">🏆 Ceinture mondiale en jeu</span>}
      </div>
    )}

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-400">
      <span class="local-date" data-iso={eventDate.toISOString()}>📅 {eventDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
      <span class="flex items-center gap-1.5" title="Heure locale de votre navigateur">
        🕒 <span class="local-time" data-iso={eventDate.toISOString()}>{eventDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</span>
        <span class="text-[10px] uppercase text-slate-500">heure locale</span>
      </span>
      {venue && <span>📍 {venue}</span>}
    </div>

    {status === 'live' && (
      <div class="mt-5 flex items-center gap-3 rounded-xl border border-rose-500/40 bg-rose-950/30 px-4 py-3">
        <span class="h-3 w-3 animate-pulse rounded-full bg-rose-500"></span>
        <p class="text-sm font-bold text-rose-300">
          EN DIRECT {channel ? `sur ${channel}` : 'maintenant'}
        </p>
        <p class="ml-auto hidden text-xs text-slate-400 sm:block">Match en cours — VPN serveur {vpnServer ?? 'Belgique'} pour rejoindre le flux officiel.</p>
      </div>
    )}

    {status === 'upcoming' && (
      <div id="countdown" data-date={eventDate.toISOString()} class="mt-5 grid grid-cols-4 gap-2 text-center">
        {['Jours', 'Heures', 'Min', 'Sec'].map((l) => (
          <div class="rounded-lg bg-slate-800/80 py-3 backdrop-blur">
            <div class="cd-val text-2xl font-black text-cyan-400">--</div>
            <div class="text-[10px] uppercase tracking-wider text-slate-500">{l}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</div>

<script>
  const el = document.getElementById('countdown');
  if (el) {
    const target = new Date(el.dataset.date ?? '').getTime();
    const vals = el.querySelectorAll('.cd-val');
    const tick = () => {
      let d = Math.max(0, target - Date.now());
      const days = Math.floor(d / 86400000); d -= days * 86400000;
      const h = Math.floor(d / 3600000); d -= h * 3600000;
      const m = Math.floor(d / 60000); d -= m * 60000;
      const s = Math.floor(d / 1000);
      [days, h, m, s].forEach((v, i) => { vals[i].textContent = String(v).padStart(2, '0'); });
    };
    tick();
    setInterval(tick, 1000);
  }
  // Heure & date localisees selon le navigateur du visiteur
  document.querySelectorAll('.local-time').forEach((n) => {
    const d = new Date(n.dataset.iso ?? '');
    if (!isNaN(d.getTime())) n.textContent = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  });
  document.querySelectorAll('.local-date').forEach((n) => {
    const d = new Date(n.dataset.iso ?? '');
    if (!isNaN(d.getTime())) n.textContent = '📅 ' + d.toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  });
</script>
