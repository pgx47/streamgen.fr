---
import deals from '../data/vpn_deals.json';
interface B { name: string; country: string }
interface Props { broadcasters: B[]; vpnServer: string }
const { broadcasters, vpnServer } = Astro.props;
const best = deals.find((d) => d.recommended) ?? deals[0];
const ctaUrl = import.meta.env.PUBLIC_VPN_AFFILIATE_URL ?? '/go/vpn';
const countries = [...new Set(broadcasters.map((b) => b.country))];
---
<div id="geocheck" data-countries={JSON.stringify(countries)} data-vpn={vpnServer}
     class="rounded-2xl border border-slate-800 bg-slate-900/90 p-5">
  <p class="text-sm font-bold uppercase tracking-wider text-slate-300">📍 Test de géoblocage</p>
  <p class="mt-2 text-sm text-slate-400" id="geo-loc">Détection de votre localisation…</p>
  <ul class="mt-3 space-y-1.5 text-sm" id="geo-list">
    {countries.map((c) => (
      <li class="geo-row flex items-center gap-2" data-country={c}>
        <span class="geo-dot h-2.5 w-2.5 rounded-full bg-slate-600"></span>
        <span class="text-slate-300">Chaînes {c}</span>
        <span class="geo-status ml-auto font-bold text-slate-500">…</span>
      </li>
    ))}
  </ul>
  <div id="geo-vpn" class="mt-4 hidden">
    <button id="geo-sim"
      class="w-full rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2.5 text-sm font-bold text-cyan-300 hover:bg-cyan-500/20">
      Simuler une connexion {vpnServer} →
    </button>
  </div>
  <div id="geo-ok" class="mt-4 hidden">
    <p class="text-sm font-bold text-emerald-300">🟢 Avec VPN : flux HD accessible immédiatement</p>
    <a href={ctaUrl} rel="nofollow sponsored noopener" target="_blank"
       class="mt-3 block rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2.5 text-center text-sm font-black text-white shadow-lg shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500">
      Débloquer mon accès maintenant ({best.name} {best.price}) →
    </a>
  </div>
</div>

<script>
  const box = document.getElementById('geocheck');
  if (box) {
    const countries = JSON.parse(box.dataset.countries || '[]');
    const vpn = box.dataset.vpn;
    const locEl = document.getElementById('geo-loc');
    const flags = { France: '🇫🇷', Belgique: '🇧🇪', Suisse: '🇨🇭', Autriche: '🇦🇹', 'Royaume-Uni': '🇬🇧', USA: '🇺🇸', Allemagne: '🇩🇪', Pologne: '🇵🇱', Scandinavie: '🇸🇪' };
    const CC2FR = { FR: 'France', BE: 'Belgique', CH: 'Suisse', AT: 'Autriche', GB: 'Royaume-Uni', UK: 'Royaume-Uni', US: 'USA', DE: 'Allemagne', PL: 'Pologne', SE: 'Scandinavie' };

    fetch('https://ipwho.is/')
      .then((r) => r.json())
      .then((d) => {
        const mine = CC2FR[d.country_code] || d.country || 'France';
        locEl.innerHTML = `Votre localisation détectée : <strong class="text-white">${mine}</strong> ${flags[mine] ?? ''}`;
        document.querySelectorAll('.geo-row').forEach((row) => {
          const c = row.dataset.country;
          const same = c === mine;
          const dot = row.querySelector('.geo-dot');
          const st = row.querySelector('.geo-status');
          dot.className = `geo-dot h-2.5 w-2.5 rounded-full ${same ? 'bg-emerald-400' : 'bg-rose-500'}`;
          st.textContent = same ? 'ACCESSIBLE' : 'GÉOBLOQUÉ';
          st.className = `geo-status ml-auto font-bold ${same ? 'text-emerald-300' : 'text-rose-300'}`;
        });
        document.getElementById('geo-vpn')?.classList.remove('hidden');
      })
      .catch(() => {
        locEl.innerHTML = 'Votre localisation détectée : <strong class="text-white">France</strong> 🇫🇷 (par défaut)';
        document.querySelectorAll('.geo-row').forEach((row) => {
          row.querySelector('.geo-dot').className = 'geo-dot h-2.5 w-2.5 rounded-full bg-rose-500';
          const st = row.querySelector('.geo-status');
          st.textContent = 'GÉOBLOQUÉ';
          st.className = 'geo-status ml-auto font-bold text-rose-300';
        });
        document.getElementById('geo-vpn')?.classList.remove('hidden');
      });

    document.getElementById('geo-sim')?.addEventListener('click', () => {
      document.querySelectorAll('.geo-row').forEach((row) => {
        row.querySelector('.geo-dot').className = 'geo-dot h-2.5 w-2.5 rounded-full bg-emerald-400';
        const st = row.querySelector('.geo-status');
        st.textContent = 'DÉBLOQUÉ';
        st.className = 'geo-status ml-auto font-bold text-emerald-300';
      });
      document.getElementById('geo-vpn')?.classList.add('hidden');
      document.getElementById('geo-ok')?.classList.remove('hidden');
    });
  }
</script>
