---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from './EventCard.astro';
import StickyVpnBar from './StickyVpnBar.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';

interface Props { sport: string; title: string; intro: string }
const { sport, title, intro } = Astro.props;
const events = (await getCollection('matches'))
  .filter((m) => m.data.sport === sport)
  .sort((a, b) => a.data.eventDate.getTime() - b.data.eventDate.getTime());
const upcoming = events.filter((e) => e.data.status !== 'finished');
const past = events.filter((e) => e.data.status === 'finished');
---
<BaseLayout title={title} description={intro}>
  <section class="py-8">
    <h1 class="text-3xl font-black text-white sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-3xl text-slate-400">{intro}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.map((e) => <EventCard entry={e} />)}
    </div>
    {upcoming.length === 0 && <p class="mt-8 text-slate-500">Aucun événement programmé pour le moment — revenez bientôt.</p>}

    {past.length > 0 && (
      <>
        <h2 class="mt-10 text-xl font-black text-slate-300">Résultats récents</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {past.map((e) => <EventCard entry={e} />)}
        </div>
      </>
    )}

    <p class="mt-10 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-500">
      {SITE.disclaimer}
    </p>
  </section>
  <StickyVpnBar />
</BaseLayout>
