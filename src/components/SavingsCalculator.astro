---
import deals from '../data/vpn_deals.json';
const best = deals.find((d) => d.recommended) ?? deals[0];
const ctaUrl = import.meta.env.PUBLIC_VPN_AFFILIATE_URL ?? '/go/vpn';
const offers = [
  { name: 'Canal+ Sport', monthly: 35 },
  { name: 'beIN Sports', monthly: 15 },
  { name: 'RMC Sport / DAZN', monthly: 30 },
];
const vpnYearly = 2.19 * 12; // ~26 €
---
<div class="rounded-2xl border border-slate-800 bg-slate-900/90 p-6 sm:p-8" id="calc">
  <h2 class="text-xl font-black text-white">💸 Combien vous coûte vraiment le sport en France ?</h2>
  <p class="mt-1 text-sm text-slate-400">Cochez les abonnements nécessaires pour tout suivre :</p>

  <div class="mt-4 space-y-2">
    {offers.map((o) => (
      <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-800 bg-slate-900 p-3 hover:border-slate-600">
        <input type="checkbox" class="sub h-4 w-4 accent-cyan-500" data-monthly={o.monthly} checked />
        <span class="flex-1 text-sm text-slate-200">{o.name}</span>
        <span class="text-sm font-bold text-rose-300">{o.monthly} €/mois</span>
      </label>
    ))}
  </div>

  <div class="mt-5 grid grid-cols-3 gap-3 text-center">
    <div class="rounded-lg bg-slate-800/70 p-3">
      <p class="text-[10px] uppercase tracking-wider text-slate-500">Abonnements FR</p>
      <p class="text-xl font-black text-rose-300"><span id="cost-fr">0</span> €/an</p>
    </div>
    <div class="rounded-lg bg-slate-800/70 p-3">
      <p class="text-[10px] uppercase tracking-wider text-slate-500">En clair + VPN</p>
      <p class="text-xl font-black text-emerald-300">{Math.round(vpnYearly)} €/an</p>
    </div>
    <div class="rounded-lg border border-emerald-500/30 bg-emerald-950/40 p-3">
      <p class="text-[10px] uppercase tracking-wider text-emerald-500">Économie</p>
      <p class="text-xl font-black text-emerald-300"><span id="savings">0</span> €/an</p>
    </div>
  </div>

  <a href={ctaUrl} rel="nofollow sponsored noopener" target="_blank"
     class="mt-5 block rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-3 text-center font-black text-white shadow-xl shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500">
    <span id="cta-text">Économiser dès ce soir</span> avec {best.name} ({best.price}) →
  </a>
</div>

<script define:vars={{ vpnYearly }}>
  const boxes = document.querySelectorAll('#calc .sub');
  const costEl = document.getElementById('cost-fr');
  const saveEl = document.getElementById('savings');
  const ctaEl = document.getElementById('cta-text');
  const update = () => {
    let yearly = 0;
    boxes.forEach((b) => { if (b.checked) yearly += parseFloat(b.dataset.monthly) * 12; });
    const save = Math.max(0, yearly - vpnYearly);
    costEl.textContent = Math.round(yearly);
    saveEl.textContent = Math.round(save);
    ctaEl.textContent = save > 0 ? `Économiser ${Math.round(save)} € dès ce soir` : 'Économiser dès ce soir';
  };
  boxes.forEach((b) => b.addEventListener('change', update));
  update();
</script>
