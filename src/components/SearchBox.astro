---
---
<div class="relative">
  <button id="search-btn" class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs font-semibold text-slate-400 hover:bg-slate-800">
    🔍 Rechercher
  </button>
</div>
<dialog id="search-modal" class="fixed inset-0 z-50 m-auto h-fit w-[92%] max-w-lg rounded-2xl border border-slate-700 bg-slate-900 p-0 backdrop:bg-black/70">
  <div class="p-4">
    <div id="search"></div>
    <p class="mt-2 text-right"><button id="search-close" class="text-xs text-slate-500 hover:text-white">Fermer ✕</button></p>
  </div>
</dialog>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
  const btn = document.getElementById('search-btn');
  const modal = document.getElementById('search-modal');
  let loaded = false;
  btn?.addEventListener('click', async () => {
    modal?.showModal();
    if (!loaded) {
      loaded = true;
      try {
        const ui = await import('/pagefind/pagefind-ui.js');
        new ui.PagefindUI({ element: '#search', showImages: false, pageSize: 6,
          translations: { placeholder: 'Match, équipe, chaîne…', no_results: 'Aucun résultat' } });
      } catch (e) { document.getElementById('search').textContent = 'Recherche indisponible'; }
    }
  });
  document.getElementById('search-close')?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
</script>
