---
import { SITE } from '../site.config';

interface Props {
  event: {
    title: string;
    description: string;
    sport: string;
    competition: string;
    homeTeam?: string;
    awayTeam?: string;
    venue?: string;
    eventDate: Date;
    status?: 'upcoming' | 'live' | 'finished';
    url: string;
    faq?: { q: string; a: string }[];
  };
}
const { event } = Astro.props;

const competitors =
  event.homeTeam && event.awayTeam
    ? [
        { '@type': 'SportsTeam', name: event.homeTeam },
        { '@type': 'SportsTeam', name: event.awayTeam },
      ]
    : [];

const eventStatus = {
  upcoming: 'https://schema.org/EventScheduled',
  live: 'https://schema.org/EventScheduled',
  finished: 'https://schema.org/EventScheduled',
}[event.status ?? 'upcoming'];

const sportsEvent = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: event.title,
  description: event.description,
  startDate: event.eventDate.toISOString(),
  eventStatus,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  sport: event.sport,
  ...(competitors.length ? { competitor: competitors } : {}),
  ...(event.venue ? { location: { '@type': 'Place', name: event.venue } } : {}),
  organizer: { '@type': 'Organization', name: event.competition },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: event.sport, item: `${SITE.url}/${event.sport}/` },
    { '@type': 'ListItem', position: 3, name: event.title, item: event.url },
  ],
};

const faqSchema = event.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: event.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<script type="application/ld+json" set:html={JSON.stringify(sportsEvent)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
