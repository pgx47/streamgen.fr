---
interface Odds { home?: string; draw?: string; away?: string; favorite?: string; homeProb?: number; drawProb?: number; awayProb?: number }
interface Props { odds?: Odds; homeTeam?: string; awayTeam?: string; fighter1?: { name: string }; fighter2?: { name: string } }
const { odds, homeTeam, awayTeam, fighter1, fighter2 } = Astro.props;
if (!odds || (!odds.home && !odds.away)) return null;
const hp = odds.homeProb ?? 50, dp = odds.drawProb ?? 0, ap = odds.awayProb ?? 50;
const duel = !odds.draw; // ufc/tennis/combat
const n1 = fighter1?.name ?? homeTeam ?? 'Domicile';
const n2 = fighter2?.name ?? awayTeam ?? 'Extérieur';
const items = duel
  ? [{ l: n1, o: odds.home, p: hp }, { l: n2, o: odds.away, p: ap }]
  : [{ l: `1 · ${n1}`, o: odds.home, p: hp }, { l: 'N · Nul', o: odds.draw, p: dp }, { l: `2 · ${n2}`, o: odds.away, p: ap }];
---
<section class="mb-8 rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
  <h2 class="text-lg font-black text-white">📊 Cotes moyennes & tendances</h2>
  <div class={`mt-4 grid gap-3 ${duel ? 'sm:grid-cols-2' : 'sm:grid-cols-3'}`}>
    {items.map((it) => (
      <div class={`relative rounded-xl border p-4 text-center ${odds.favorite && it.l.includes(odds.favorite) ? 'border-emerald-500/50 bg-emerald-950/20' : 'border-slate-800 bg-slate-900'}`}>
        {odds.favorite && it.l.includes(odds.favorite) && (
          <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 rounded bg-emerald-400 px-2 py-0.5 text-[10px] font-black uppercase text-emerald-950">Favori</span>
        )}
        <p class="text-xs font-semibold text-slate-400">{it.l}</p>
        <p class="mt-1 text-2xl font-black text-white">{it.o ?? '—'}</p>
        <p class="text-xs font-bold text-cyan-400">{it.p != null ? `${it.p}%` : ''}</p>
      </div>
    ))}
  </div>
  <div class="mt-4 flex h-2.5 overflow-hidden rounded-full">
    <div class="bg-cyan-500" style={`width:${hp}%`}></div>
    {dp > 0 && <div class="bg-slate-600" style={`width:${dp}%`}></div>}
    <div class="bg-rose-500" style={`width:${ap}%`}></div>
  </div>
  <p class="mt-4 text-[10px] leading-relaxed text-slate-600">
    Cotes indicatives moyennes du marché européen relevées à titre d'information sportive.
    Aucun pari n'est proposé sur StreamGen.fr. Jouer comporte des risques. 18+.
  </p>
</section>
