---
import BaseLayout from './BaseLayout.astro';
import StickyVpnBar from '../components/StickyVpnBar.astro';
import VpnCallout from '../components/VpnCallout.astro';
import { SITE } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'guides'>; headings: { depth: number; text: string; slug: string }[] }
const { entry, headings } = Astro.props;
const d = entry.data;
const pageUrl = `${SITE.url}/astuces/${entry.id}/`;
const cats: Record<string, string> = {
  'chaines-etrangeres': 'Chaînes étrangères',
  'svod-cinema': 'SVOD & Cinéma',
  'economies': 'Économies',
  'tutoriels-vpn': 'Tutoriels VPN',
};
const toc = headings.filter((h) => h.depth === 2);

const howTo = d.schemaType === 'HowTo' && d.steps.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: d.title,
      description: d.description,
      step: d.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: d.title,
      description: d.description,
      datePublished: d.publishDate,
      dateModified: d.updatedDate,
      mainEntityOfPage: pageUrl,
    };
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Astuces', item: `${SITE.url}/astuces/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};
const faqSchema = d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<BaseLayout title={d.title} description={d.description}>
  <script type="application/ld+json" set:html={JSON.stringify(howTo)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}

  <article class="py-8">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-cyan-400">Accueil</a> /
      <a href="/astuces/" class="hover:text-cyan-400"> Astuces</a> /
      <span class="text-slate-300"> {d.title.slice(0, 40)}…</span>
    </nav>

    <div class="flex flex-wrap items-center gap-3">
      <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-bold text-cyan-300">{cats[d.category]}</span>
      <span class="text-xs text-slate-500">Mis à jour le {new Date(d.updatedDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      {d.vpnRequired && <span class="rounded-full border border-emerald-500/30 bg-emerald-950/50 px-3 py-1 text-xs font-bold text-emerald-300">🔓 VPN requis{d.vpnCountry ? ` · ${d.vpnCountry}` : ''}</span>}
    </div>

    <h1 class="mt-4 max-w-3xl text-3xl font-black text-white sm:text-4xl">{d.title}</h1>
    <p class="mt-3 max-w-3xl text-slate-400">{d.description}</p>

    {toc.length > 1 && (
      <div class="mt-6 rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Sommaire</p>
        <ul class="mt-2 space-y-1 text-sm">
          {toc.map((h) => <li><a href={`#${h.slug}`} class="text-cyan-400 hover:text-cyan-300">{h.text}</a></li>)}
        </ul>
      </div>
    )}

    {d.vpnRequired && <VpnCallout country={d.vpnCountry ?? 'Belgique'} />}

    <div class="prose-sport mt-8 max-w-none">
      <slot />
    </div>

    {d.faq.length > 0 && (
      <section class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="mb-4 text-xl font-black text-white">❓ Questions fréquentes</h2>
        <div class="space-y-4">
          {d.faq.map((f) => (
            <details class="group rounded-lg border border-slate-800 bg-slate-900 p-4">
              <summary class="cursor-pointer font-semibold text-slate-200 group-open:text-cyan-300">{f.q}</summary>
              <p class="mt-2 text-sm text-slate-400">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <p class="mt-10 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-500">
      {SITE.disclaimer}
    </p>
  </article>
  <StickyVpnBar />
</BaseLayout>
