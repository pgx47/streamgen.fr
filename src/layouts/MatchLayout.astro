---
import BaseLayout from './BaseLayout.astro';
import Scoreboard from '../components/Scoreboard.astro';
import BroadcasterTable from '../components/BroadcasterTable.astro';
import VpnTutorial from '../components/VpnTutorial.astro';
import StickyVpnBar from '../components/StickyVpnBar.astro';
import SeoSchema from '../components/SeoSchema.astro';
import { SITE } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'matches'> }
const { entry } = Astro.props;
const d = entry.data;
const pageUrl = `${SITE.url}/${d.sport}/${entry.id}/`;
const seoTitle = d.seoTitle ?? `${d.title} : Sur quelle chaîne regarder en streaming direct et en clair ?`;
const free = d.freeBroadcasters;
const topFree = free[0];
---
<BaseLayout title={seoTitle} description={d.description}>
  <SeoSchema slot="head" event={{ ...d, url: pageUrl }} />

  <article class="py-8">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-cyan-400">Accueil</a> /
      <a href={`/${d.sport}/`} class="hover:text-cyan-400 capitalize"> {d.sport.replace('-', ' ')}</a> /
      <span class="text-slate-300"> {d.title}</span>
    </nav>

    <h1 class="mb-6 text-2xl font-black text-white sm:text-4xl">
      {d.title} : sur quelle chaîne regarder en direct ?
    </h1>

    <Scoreboard
      title={d.title} competition={d.competition} sport={d.sport}
      homeTeam={d.homeTeam} awayTeam={d.awayTeam} venue={d.venue}
      eventDate={d.eventDate} status={d.status} score={d.score}
    />

    <div class="mt-8 space-y-8">
      <BroadcasterTable free={free} paid={d.paidBroadcasters} />

      <VpnTutorial
        country={d.vpnServer}
        channelName={topFree.name}
        channelUrl={topFree.url}
      />

      <div class="prose-sport max-w-none">
        <slot />
      </div>

      {d.faq.length > 0 && (
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="mb-4 text-xl font-black text-white">❓ Questions fréquentes</h2>
          <div class="space-y-4">
            {d.faq.map((f) => (
              <details class="group rounded-lg border border-slate-800 bg-slate-900 p-4">
                <summary class="cursor-pointer font-semibold text-slate-200 group-open:text-cyan-300">{f.q}</summary>
                <p class="mt-2 text-sm text-slate-400">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <p class="mt-10 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-500">
      {SITE.disclaimer}
    </p>
  </article>

  <StickyVpnBar />
</BaseLayout>
