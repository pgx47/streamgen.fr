---
import BaseLayout from './BaseLayout.astro';
import Scoreboard from '../components/Scoreboard.astro';
import BroadcasterTable from '../components/BroadcasterTable.astro';
import VpnTutorial from '../components/VpnTutorial.astro';
import StickyVpnBar from '../components/StickyVpnBar.astro';
import SeoSchema from '../components/SeoSchema.astro';
import CalendarButton from '../components/CalendarButton.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import GeoBlockDetector from '../components/GeoBlockDetector.astro';
import VpnComparisonTable from '../components/VpnComparisonTable.astro';
import RadioPlayer from '../components/RadioPlayer.astro';
import Lineup from '../components/Lineup.astro';
import WeekendSchedule from '../components/WeekendSchedule.astro';
import FightCard from '../components/FightCard.astro';
import TrackWeather from '../components/TrackWeather.astro';
import HardwareWidget from '../components/HardwareWidget.astro';
import ReplaySection from '../components/ReplaySection.astro';
import OddsWidget from '../components/OddsWidget.astro';
import { SITE } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'matches'> }
const { entry } = Astro.props;
const d = entry.data;
const pageUrl = `${SITE.url}/${d.sport}/${entry.id}/`;
const seoTitle = d.seoTitle ?? (/:.*(direct|clair)/i.test(d.title) ? `${d.title} — où le regarder ?` : `${d.title} : Sur quelle chaîne regarder en streaming direct et en clair ?`);
const free = d.freeBroadcasters;
const topFree = free[0];
---
<BaseLayout title={seoTitle} description={d.description}>
  <SeoSchema slot="head" event={{ ...d, url: pageUrl }} />

  <article class="py-8">
    <nav class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-cyan-400">Accueil</a> /
      <a href={`/${d.sport}/`} class="hover:text-cyan-400 capitalize"> {d.sport.replace('-', ' ')}</a> /
      <span class="text-slate-300"> {d.title}</span>
    </nav>

    <h1 class="mb-6 text-2xl font-black text-white sm:text-4xl">
      {d.status === 'finished'
        ? `${d.title} : regarder le replay intégral gratuitement`
        : /:.*(direct|clair)/i.test(d.title)
          ? `${d.title} : sur quelle chaîne en clair ?`
          : `${d.title} : sur quelle chaîne regarder en direct ?`}
    </h1>

    <div class="mb-8">
      <Scoreboard
        title={d.title} competition={d.competition} sport={d.sport}
        homeTeam={d.homeTeam} awayTeam={d.awayTeam} venue={d.venue}
        homeTeamLogo={d.homeTeamLogo} awayTeamLogo={d.awayTeamLogo}
        eventPoster={d.eventPoster}
        eventDate={d.eventDate} status={d.status} score={d.score}
        channel={topFree.name} vpnServer={d.vpnServer}
        fighter1={d.fighter1} fighter2={d.fighter2}
        weightClass={d.weightClass} titleFight={d.titleFight}
      />
    </div>

    {d.status !== 'finished' && (
      <OddsWidget odds={d.odds} homeTeam={d.homeTeam} awayTeam={d.awayTeam}
                  fighter1={d.fighter1} fighter2={d.fighter2} />
    )}

    <div class="mb-8"><WeekendSchedule schedule={d.schedule} channel={topFree.name} /></div>
    <div class="mb-8"><FightCard fights={d.fightCard} /></div>

    {d.status !== 'finished' ? (
      <div class="mt-5">
        <CalendarButton
          title={d.title} eventDate={d.eventDate}
          channel={topFree.name} vpnServer={d.vpnServer} url={pageUrl}
        />
      </div>
    ) : (
      <div class="mt-5 rounded-2xl border border-emerald-500/30 bg-emerald-950/30 p-5">
        <p class="font-bold text-emerald-300">📼 Replay intégral disponible gratuitement</p>
        <p class="mt-1 text-sm text-slate-300">
          {topFree.name} conserve l'événement en replay intégral ~7 jours — gratuit avec un compte et un serveur VPN {d.vpnServer}.
        </p>
        <a href={topFree.url} rel="nofollow sponsored noopener" target="_blank"
           class="mt-3 inline-block rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 px-5 py-2.5 text-sm font-black text-white hover:from-cyan-400 hover:to-blue-500">
          Voir le replay sur {topFree.name} ↗
        </a>
      </div>
    )}

    <div class="mt-5">
      <GeoBlockDetector broadcasters={free} vpnServer={d.vpnServer} />
    </div>

    <div class="mt-8 space-y-8">
      <p class="flex items-center gap-2 text-sm font-semibold text-emerald-300">
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 text-[11px] font-black text-slate-950">✓</span>
        Chaînes officielles en clair — fiche vérifiée le {new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>
      <BroadcasterTable free={free} paid={d.paidBroadcasters} />

      {!free.some((b) => b.lang === 'FR') && <RadioPlayer />}

      {(['football','rugby'].includes(d.sport) && (d.homeLineup || d.awayLineup)) && (
        <Lineup home={d.homeLineup} away={d.awayLineup} homeTeam={d.homeTeam} awayTeam={d.awayTeam} />
      )}

      <VpnTutorial
        country={d.vpnServer}
        channelName={topFree.name}
        channelUrl={topFree.url}
      />

      <aside class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">📚 Guides associés</p>
        <ul class="mt-2 space-y-1.5 text-sm">
          {(d.sport === 'formule-1' || d.sport === 'motogp') && (
            <li><a class="text-cyan-400 hover:text-cyan-300" href="/astuces/f1-motogp-chaines-etrangeres-gratuites/">F1 & MotoGP : toutes les chaînes étrangères gratuites en clair</a></li>
          )}
          <li><a class="text-cyan-400 hover:text-cyan-300" href="/tutoriel-vpn/">Tutoriel VPN : regarder les chaînes étrangères depuis la France</a></li>
          <li><a class="text-cyan-400 hover:text-cyan-300" href="/astuces/reduire-facture-abonnements-streaming-legal/">Diviser par 4 ses abonnements streaming (co-abonnement légal)</a></li>
        </ul>
      </aside>

      <div class="prose-sport max-w-none">
        <slot />
      </div>

      <section>
        <h2 class="mb-4 text-xl font-black text-white">Quel VPN choisir pour ce match ?</h2>
        <VpnComparisonTable />
      </section>

      <SavingsCalculator />

      {d.faq.length > 0 && (
        <section class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="mb-4 text-xl font-black text-white">❓ Questions fréquentes</h2>
          <div class="space-y-4">
            {d.faq.map((f) => (
              <details class="group rounded-lg border border-slate-800 bg-slate-900 p-4">
                <summary class="cursor-pointer font-semibold text-slate-200 group-open:text-cyan-300">{f.q}</summary>
                <p class="mt-2 text-sm text-slate-400">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <p class="mt-10 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-500">
      {SITE.disclaimer}
    </p>
  </article>

  <StickyVpnBar />
</BaseLayout>
