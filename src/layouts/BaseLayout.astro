---
import SearchBox from '../components/SearchBox.astro';
import LiveScores from '../components/LiveScores.astro';
import '../styles/global.css';
import { SITE, SPORTS } from '../site.config';
import { getCollection } from 'astro:content';

const liveSports = new Set(
  (await getCollection('matches')).filter((m) => m.data.status === 'live').map((m) => m.data.sport)
);

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="fr" class="bg-slate-950">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="mylead-verification" content="e591b24bd8eb3615a660ac93141718f7" />
  <!-- mylead-verification: e591b24bd8eb3615a660ac93141718f7 -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0f172a" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:image" content={`${SITE.url}/og-image.png`} />
  <slot name="head" />
  {SITE.analyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
    <script is:inline define:vars={{ id: SITE.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)}
      gtag('js', new Date()); gtag('config', id);
    </script>
  )}
</head>
<body class="min-h-screen font-sans antialiased">
  <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
      <a href="/" class="flex items-center">
        <img src="/logo.png" alt="StreamGen" class="h-11 w-auto" width="600" height="143" />
      </a>
      <nav class="ml-auto flex items-center gap-0.5 whitespace-nowrap text-xs font-semibold">
        {SPORTS.filter((s) => ['football','formule-1','ufc','motogp'].includes(s.slug)).map((s) => (
          <a href={`/${s.slug}/`} class="hidden items-center gap-1.5 whitespace-nowrap rounded-lg px-2.5 py-2 text-slate-300 hover:bg-slate-800 hover:text-white xl:inline-flex">
            {s.label}
            {liveSports.has(s.slug) && <span class="h-2 w-2 animate-pulse rounded-full bg-rose-500" title="En direct" />}
          </a>
        ))}
        <div class="group relative hidden xl:block">
          <button class="flex items-center gap-1 whitespace-nowrap rounded-lg px-2.5 py-2 text-slate-300 hover:bg-slate-800 hover:text-white">
            Sports ▾
          </button>
          <div class="invisible absolute right-0 top-full z-50 mt-1 w-44 rounded-xl border border-slate-800 bg-slate-900 py-2 opacity-0 shadow-2xl transition group-hover:visible group-hover:opacity-100">
            {SPORTS.filter((s) => !['football','formule-1','ufc','motogp'].includes(s.slug)).map((s) => (
              <a href={`/${s.slug}/`} class="flex items-center gap-2 whitespace-nowrap px-4 py-2 text-slate-300 hover:bg-slate-800 hover:text-white">
                <span>{s.icon}</span>{s.label}
                {liveSports.has(s.slug) && <span class="ml-auto h-1.5 w-1.5 animate-pulse rounded-full bg-rose-500" />}
              </a>
            ))}
          </div>
        </div>
        <a href="/programme-tv-sport/" class="hidden whitespace-nowrap rounded-lg px-2.5 py-2 text-slate-300 hover:bg-slate-800 hover:text-white xl:inline-block">Programme TV</a>
        <a href="/astuces/" class="hidden whitespace-nowrap rounded-lg px-2.5 py-2 text-slate-300 hover:bg-slate-800 hover:text-white xl:inline-block">Astuces</a>
        <div class="ml-3 flex items-center gap-3 border-l border-slate-800 pl-4">
          <SearchBox />
          <a href="/tutoriel-vpn/" class="whitespace-nowrap rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2 text-xs font-extrabold text-white shadow-lg shadow-cyan-500/20 transition-all hover:from-cyan-400 hover:to-blue-500">Tuto VPN</a>
        </div>
        <button id="nav-toggle" aria-label="Menu" class="rounded-lg p-2 text-slate-300 hover:bg-slate-800 xl:hidden">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </nav>
    </div>
    <div id="nav-menu" class="hidden border-t border-slate-800 px-4 pb-4 xl:hidden">
      <div class="grid grid-cols-2 gap-1 pt-3 text-sm font-semibold">
        {SPORTS.map((s) => (
          <a href={`/${s.slug}/`} class="flex items-center gap-1.5 rounded-lg px-3 py-2.5 text-slate-300 hover:bg-slate-800">
            {s.label}
            {liveSports.has(s.slug) && <span class="h-2 w-2 animate-pulse rounded-full bg-rose-500" />}
          </a>
        ))}
        <a href="/astuces/" class="rounded-lg px-3 py-2.5 text-slate-300 hover:bg-slate-800">Astuces</a>
        <a href="/programme-tv-sport/" class="rounded-lg px-3 py-2.5 text-slate-300 hover:bg-slate-800">Programme TV</a>
        <a href="/streaming-legal/" class="rounded-lg px-3 py-2.5 text-slate-300 hover:bg-slate-800">Streaming légal</a>
        <a href="/a-propos/" class="rounded-lg px-3 py-2.5 text-slate-300 hover:bg-slate-800">À propos</a>
      </div>
    </div>
  </header>
  <script>
    document.getElementById('nav-toggle')?.addEventListener('click', () => {
      document.getElementById('nav-menu')?.classList.toggle('hidden');
    });
  </script>

  <main class="mx-auto max-w-6xl px-4 pb-28">
    <slot />
  </main>
  <LiveScores />

  <footer class="border-t border-slate-800 bg-slate-900/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-black text-white">Stream<span class="text-cyan-400">Gen</span></p>
        <p class="mt-2 text-sm text-slate-400">{SITE.tagline}. Trouvez où regarder chaque match, légalement et au meilleur prix.</p>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Sports</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          {SPORTS.map((s) => <li><a class="hover:text-cyan-400" href={`/${s.slug}/`}>{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Guides</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          <li><a class="hover:text-cyan-400" href="/programme-tv-sport/">Programme TV sport</a></li>
          <li><a class="hover:text-cyan-400" href="/actualites/">Actus droits TV</a></li>
          <li><a class="hover:text-cyan-400" href="/astuces/">Astuces & déblocage</a></li>
          <li><a class="hover:text-cyan-400" href="/tutoriel-vpn/">Tutoriel VPN</a></li>
          <li><a class="hover:text-cyan-400" href="/streaming-legal/">Streaming légal : les règles</a></li>
          <li><a class="hover:text-cyan-400" href="/a-propos/">À propos</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Légal</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          <li><a class="hover:text-cyan-400" href="/mentions-legales/">Mentions légales</a></li>
          <li><a class="hover:text-cyan-400" href="/confidentialite/">Politique de confidentialité</a></li>
          <li><a class="hover:text-cyan-400" href="/avertissement-legal/">Avertissement & anti-piratage</a></li>
          <li><a class="hover:text-cyan-400" href="/affiliation/">Transparence affiliation</a></li>
          <li><a class="hover:text-cyan-400" href="/contact/">Contact & signalements</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-slate-800 px-4 py-5">
      <p class="mx-auto max-w-6xl text-xs leading-relaxed text-slate-500">{SITE.disclaimer}</p>
      <p class="mx-auto mt-2 max-w-6xl text-xs text-slate-600">© {new Date().getFullYear()} {SITE.name}. Certains liens sont des liens affiliés.</p>
    </div>
      <div class="border-t border-slate-800/60 px-4 py-3 text-center text-[11px] text-slate-500">
      Nos autres sites : <a href="https://streamlib.fr" class="text-slate-400 hover:text-cyan-300 transition-colors">StreamLib</a> &middot; <a href="https://missstream.xyz" class="text-slate-400 hover:text-cyan-300 transition-colors">missstream</a> &middot; <a href="https://www.guidemontessori.fr" class="text-slate-400 hover:text-cyan-300 transition-colors">GuideMontessori</a>
    </div>
  </footer>
</body>
</html>
