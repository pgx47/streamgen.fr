---
import '../styles/global.css';
import { SITE, SPORTS } from '../site.config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="fr" class="bg-slate-950">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:image" content={`${SITE.url}/og-image.png`} />
  <slot name="head" />
  {SITE.analyticsId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
    <script is:inline define:vars={{ id: SITE.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)}
      gtag('js', new Date()); gtag('config', id);
    </script>
  )}
</head>
<body class="min-h-screen font-sans antialiased">
  <header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3">
      <a href="/" class="flex items-center">
        <img src="/logo.png" alt="StreamGen" class="h-12 w-auto" width="600" height="143" />
      </a>
      <nav class="ml-auto flex items-center gap-1 text-sm font-semibold">
        {SPORTS.map((s) => (
          <a href={`/${s.slug}/`} class="rounded-lg px-3 py-2 text-slate-300 hover:bg-slate-800 hover:text-white">{s.label}</a>
        ))}
        <a href="/tutoriel-vpn/" class="rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 px-3 py-2 font-bold text-white hover:from-cyan-400 hover:to-blue-500">Tuto VPN</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 pb-28">
    <slot />
  </main>

  <footer class="border-t border-slate-800 bg-slate-900/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-black text-white">Stream<span class="text-cyan-400">Gen</span></p>
        <p class="mt-2 text-sm text-slate-400">{SITE.tagline}. Trouvez où regarder chaque match, légalement et au meilleur prix.</p>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Sports</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          {SPORTS.map((s) => <li><a class="hover:text-cyan-400" href={`/${s.slug}/`}>{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Guides</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          <li><a class="hover:text-cyan-400" href="/tutoriel-vpn/">Tutoriel VPN</a></li>
          <li><a class="hover:text-cyan-400" href="/a-propos/">À propos</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-slate-300">Légal</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-400">
          <li><a class="hover:text-cyan-400" href="/mentions-legales/">Mentions légales</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-slate-800 px-4 py-5">
      <p class="mx-auto max-w-6xl text-xs leading-relaxed text-slate-500">{SITE.disclaimer}</p>
      <p class="mx-auto mt-2 max-w-6xl text-xs text-slate-600">© {new Date().getFullYear()} {SITE.name}. Certains liens sont des liens affiliés.</p>
    </div>
  </footer>
</body>
</html>
