---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyVpnBar from '../../components/StickyVpnBar.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('news'))
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));
---
<BaseLayout title="Actualités droits TV & diffuseurs" description="Droits TV, tarifs des diffuseurs et chaînes en clair : les brèves qui changent l'accès au sport en France.">
  <section class="py-8">
    <h1 class="text-3xl font-black text-white sm:text-4xl">Actualités droits TV</h1>
    <p class="mt-3 max-w-3xl text-slate-400">Hausses de tarifs, attributions de droits, nouvelles chaînes en clair — ce qui change votre accès au sport, et l'alternative légale à chaque fois.</p>
    <div class="mt-6 space-y-4">
      {items.length === 0 && <p class="text-slate-500">Les premières brèves arrivent au prochain passage du robot — mercredi et samedi matin.</p>}
      {items.map((n) => (
        <a href={`/actualites/${n.id}/`} class="block rounded-xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-cyan-500/40">
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
            <span class="font-bold uppercase tracking-wide text-cyan-400">Droits TV</span>
            <span>{new Date(n.data.publishDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            {n.data.sourceName && <span>· {n.data.sourceName}</span>}
          </div>
          <h2 class="mt-2 font-bold text-white">{n.data.title}</h2>
          <p class="mt-1 text-sm text-slate-500">{n.data.description}</p>
        </a>
      ))}
    </div>
  </section>
  <StickyVpnBar />
</BaseLayout>
