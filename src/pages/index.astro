---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import StickyVpnBar from '../components/StickyVpnBar.astro';
import VpnTutorial from '../components/VpnTutorial.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import { getCollection } from 'astro:content';
import { SITE, SPORTS } from '../site.config';
import deals from '../data/vpn_deals.json';

const events = (await getCollection('matches'))
  .sort((a, b) => a.data.eventDate.getTime() - b.data.eventDate.getTime());
const upcoming = events.filter((e) => e.data.status !== 'finished');
const finished7d = events.filter((e) => e.data.status === 'finished'
  && Date.now() - e.data.eventDate.getTime() < 7 * 864e5)
  .sort((a, b) => b.data.eventDate.getTime() - a.data.eventDate.getTime()).slice(0, 6);
const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate))
  .slice(0, 3);
const best = deals.find((d) => d.recommended) ?? deals[0];
const ctaUrl = import.meta.env.PUBLIC_VPN_AFFILIATE_URL ?? '/go/vpn';
---
<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description}>
  <section class="py-10 text-center sm:py-14">
    <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-950/50 px-4 py-1.5 text-xs font-bold text-emerald-300">
      ✔ 100 % légal · chaînes officielles en clair
    </p>
    <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-black leading-tight text-white sm:text-5xl">
      Le comparateur des <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">retransmissions sportives en clair</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-slate-400">
      Foot, F1, UFC, MotoGP : les chaînes publiques belges, suisses et autrichiennes diffusent les mêmes événements
      <strong class="text-emerald-400"> en clair et gratuitement</strong>. StreamGen vous dit où — et comment y accéder légalement.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="#evenements" class="rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-3 font-black text-white shadow-xl shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500">
        Voir le programme en clair →
      </a>
      <a href="/tutoriel-vpn/" class="rounded-xl border border-slate-700 px-6 py-3 font-bold text-slate-200 hover:bg-slate-800">
        Comment fonctionne le déblocage ?
      </a>
    </div>
  </section>

  <div class="my-8 border-y border-slate-800 bg-slate-900/40 py-3">
    <div class="mx-auto flex max-w-5xl flex-wrap justify-around gap-4 px-4 text-xs font-semibold text-slate-400">
      <span>✓ 100 % chaînes publiques officielles</span>
      <span>✓ Aucun flux illégal hébergé ou relayé</span>
      <span>✓ Horaires et diffuseurs vérifiés chaque matin</span>
    </div>
  </div>

  <section id="evenements">
    <h2 class="text-2xl font-black text-white">À l'affiche cette semaine</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {upcoming.slice(0, 9).map((e) => <EventCard entry={e} />)}
    </div>
  </section>

  <section class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {SPORTS.map((s) => (
      <a href={`/${s.slug}/`} class="rounded-xl border border-slate-800 bg-slate-900/80 p-5 text-center transition hover:border-cyan-500/40">
        <span class="text-3xl">{s.icon}</span>
        <p class="mt-2 font-bold text-white">{s.label}</p>
        <p class="text-xs text-slate-500">Calendrier & diffuseurs</p>
      </a>
    ))}
  </section>

  {finished7d.length > 0 && (
    <section class="mt-14">
      <h2 class="text-2xl font-black text-white">Derniers résultats & replays</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {finished7d.map((e) => <EventCard entry={e} />)}
      </div>
    </section>
  )}

  {newsItems.length > 0 && (
    <section class="mt-14">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-black text-white">Dernières actus droits TV</h2>
        <a href="/actualites/" class="text-sm font-semibold text-cyan-400 hover:text-cyan-300">Toutes les actus →</a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {newsItems.map((n) => (
          <a href={`/actualites/${n.id}/`} class="rounded-xl border border-slate-800 bg-slate-900/80 p-4 transition hover:border-cyan-500/40">
            <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-400">{new Date(n.data.publishDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</p>
            <h3 class="mt-1.5 text-sm font-bold text-white">{n.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mt-14">
    <SavingsCalculator />
  </section>

  <section class="mt-14">
    <VpnTutorial />
  </section>

  <StickyVpnBar />
</BaseLayout>
