---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyVpnBar from '../components/StickyVpnBar.astro';
import VpnComparisonTable from '../components/VpnComparisonTable.astro';
import deals from '../data/vpn_deals.json';
---
<BaseLayout title="VPN pas cher : codes promo et meilleures offres streaming 2026"
  description="Les promos VPN du moment pour débloquer les chaînes étrangères : CyberGhost à 2,19 €/mois, comparatif NordVPN et Surfshark, garanties 45 jours.">
  <article class="prose-sport max-w-3xl py-10">
    <h1 class="text-3xl font-black text-white sm:text-4xl">VPN pas cher : les vraies offres du moment</h1>
    <p class="mt-3 text-slate-400">Pour regarder le sport en clair sur les chaînes étrangères, un VPN fiable suffit — et il coûte moins de 3 €/mois en longue période. Voici les promos réelles, vérifiées.</p>
  </article>
  <VpnComparisonTable />
  <div class="mt-8 space-y-4 max-w-3xl">
    {deals.map((d) => (
      <div class="flex items-center gap-4 rounded-xl border border-slate-800 bg-slate-900/80 p-4">
        <div class="flex-1">
          <p class="font-bold text-white">{d.name} {d.recommended && <span class="ml-2 rounded bg-emerald-400 px-1.5 py-0.5 text-[10px] font-black uppercase text-emerald-950">Best deal</span>}</p>
          <p class="text-xs text-slate-500">{d.discount} · garantie {d.guarantee}</p>
        </div>
        <p class="text-lg font-black text-cyan-400">{d.price}</p>
        <a href="/go/vpn" rel="nofollow sponsored noopener" class="rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 px-4 py-2 text-sm font-black text-white">Profiter →</a>
      </div>
    ))}
  </div>
  <StickyVpnBar />
</BaseLayout>
