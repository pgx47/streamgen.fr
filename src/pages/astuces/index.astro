---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyVpnBar from '../../components/StickyVpnBar.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides'))
  .sort((a, b) => b.data.publishDate.localeCompare(a.data.publishDate));
const cats: Record<string, { label: string; cls: string }> = {
  'chaines-etrangeres': { label: 'Chaînes étrangères', cls: 'border-emerald-500/30 bg-emerald-950/50 text-emerald-300' },
  'svod-cinema': { label: 'SVOD & Cinéma', cls: 'border-violet-500/30 bg-violet-950/50 text-violet-300' },
  'economies': { label: 'Économies', cls: 'border-amber-500/30 bg-amber-950/50 text-amber-300' },
  'tutoriels-vpn': { label: 'Tutoriels VPN', cls: 'border-cyan-500/30 bg-cyan-950/50 text-cyan-300' },
};
const categories = [...new Set(guides.map((g) => g.data.category))];
---
<BaseLayout title="Astuces & déblocage : guides streaming légal" description="Guides evergreen : chaînes étrangères en clair, plateformes gratuites (BBC iPlayer, Tubi), catalogues SVOD internationaux et astuces pour réduire vos abonnements — 100 % légal.">
  <section class="py-8">
    <h1 class="text-3xl font-black text-white sm:text-4xl">Astuces & déblocage légal</h1>
    <p class="mt-3 max-w-3xl text-slate-400">
      Guides permanents : chaînes étrangères gratuites, plateformes FAST, catalogues internationaux
      et techniques légales pour diviser vos factures de streaming.
    </p>

    <div class="mt-6 flex flex-wrap gap-2" id="filters">
      <button data-cat="all" class="fbtn rounded-full border border-cyan-500/40 bg-cyan-500/10 px-4 py-1.5 text-sm font-bold text-cyan-300">Tous</button>
      {categories.map((c) => (
        <button data-cat={c} class="fbtn rounded-full border border-slate-700 px-4 py-1.5 text-sm font-bold text-slate-300 hover:bg-slate-800">{cats[c].label}</button>
      ))}
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="grid">
      {guides.map((g) => (
        <a href={`/astuces/${g.id}/`} data-cat={g.data.category}
           class="gcard group flex flex-col rounded-xl border border-slate-800 bg-slate-900/80 p-5 transition hover:border-cyan-500/40">
          <span class={`w-fit rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${cats[g.data.category].cls}`}>{cats[g.data.category].label}</span>
          <h2 class="mt-3 font-bold text-white group-hover:text-cyan-300">{g.data.title}</h2>
          <p class="mt-2 flex-1 text-sm text-slate-500">{g.data.description}</p>
          <div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
            {g.data.vpnRequired && <span class="text-emerald-400 font-semibold">🔓 VPN {g.data.vpnCountry ?? ''}</span>}
            <span class="ml-auto group-hover:text-cyan-400">Lire →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <StickyVpnBar />
</BaseLayout>

<script>
  const btns = document.querySelectorAll('.fbtn');
  const cards = document.querySelectorAll('.gcard');
  btns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.cat;
    btns.forEach((x) => x.classList.remove('border-cyan-500/40', 'bg-cyan-500/10', 'text-cyan-300'));
    b.classList.add('border-cyan-500/40', 'bg-cyan-500/10', 'text-cyan-300');
    cards.forEach((c) => {
      c.classList.toggle('hidden', cat !== 'all' && (c as HTMLElement).dataset.cat !== cat);
    });
  }));
</script>
