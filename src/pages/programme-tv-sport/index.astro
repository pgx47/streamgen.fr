---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyVpnBar from '../../components/StickyVpnBar.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../site.config';

const icons: Record<string, string> = { football: '⚽', 'formule-1': '🏎️', ufc: '🥊', motogp: '🏍️', tennis: '🎾', rugby: '🏉', cyclisme: '🚴', 'sports-hiver': '⛷️', combat: '🥊' };
const now = new Date();
const events = (await getCollection('matches')).sort((a, b) => a.data.eventDate.getTime() - b.data.eventDate.getTime());
const sameDay = (d: Date, ref: Date) => d.toDateString() === ref.toDateString();
const tomorrow = new Date(now.getTime() + 864e5);
const comps = [...new Set(events.map((e) => e.data.competition))];
const groups = [
  { label: `Aujourd'hui — ${now.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}`,
    items: events.filter((e) => sameDay(e.data.eventDate, now)) },
  { label: `Demain — ${tomorrow.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })}`,
    items: events.filter((e) => sameDay(e.data.eventDate, tomorrow)) },
  { label: 'Cette semaine',
    items: events.filter((e) => e.data.eventDate > tomorrow && e.data.eventDate.getTime() - now.getTime() < 7 * 864e5) },
];
const favicon = (u: string) => `https://www.google.com/s2/favicons?domain=${new URL(u).hostname}&sz=64`;
const badge = { upcoming: 'À venir', live: '🔴 Direct', finished: 'Terminé' };
---
<BaseLayout title="Programme TV sport aujourd'hui : matchs et directs en clair"
  description="Programme TV sport complet : chaînes payantes et diffusions en clair (TNT, RTBF, RTS), filtrable, avec logos des diffuseurs.">
  <section class="py-8">
    <h1 class="text-3xl font-black text-white sm:text-4xl">📺 Programme TV sport</h1>
    <p class="mt-2 text-slate-400">Diffusions du jour et de la semaine — chaînes payantes et en clair.</p>

    <label class="mt-5 flex w-fit cursor-pointer items-center gap-3 rounded-lg border border-emerald-500/30 bg-emerald-950/40 px-4 py-2.5">
      <input type="checkbox" id="freeOnly" class="h-4 w-4 accent-emerald-500" />
      <span class="text-sm font-bold text-emerald-300">En clair uniquement</span>
    </label>

    <div class="mt-4 flex flex-wrap gap-2" id="pills">
      <button data-c="" class="pill rounded-lg border border-cyan-500/50 bg-cyan-500/15 px-3 py-1.5 text-xs font-bold text-cyan-300">Tous</button>
      {comps.map((c) => (
        <button data-c={c} class="pill rounded-lg border border-slate-700 bg-slate-900/70 px-3 py-1.5 text-xs font-bold text-slate-300 transition hover:border-cyan-500/40">{c}</button>
      ))}
    </div>

    {groups.map((g) => g.items.length > 0 && (
      <>
        <h2 class="mt-8 text-xl font-black text-white">{g.label}</h2>
        <div class="mt-3 space-y-2.5">
          {g.items.map((e) => { const d = e.data; const hLogo = d.homeTeamLogo || d.fighter1?.photo; const aLogo = d.awayTeamLogo || d.fighter2?.photo; return (
            <a href={`/${d.sport}/${e.id}/`} data-comp={d.competition} class={`ev block rounded-xl border p-4 transition hover:border-cyan-500/40 ${d.status === 'finished' ? 'border-slate-800/60 bg-slate-900/40 opacity-70' : 'border-slate-800 bg-slate-900/80'}`}>
              <div class="flex items-center gap-3">
                <span class="text-lg">{icons[d.sport] ?? '🏆'}</span>
                {(hLogo || aLogo) && (
                  <span class="flex items-center gap-1.5">
                    {hLogo && <img src={hLogo} alt="" class="h-7 w-7 rounded object-contain bg-slate-800 p-0.5" loading="lazy" />}
                    <span class="text-[10px] font-black text-slate-600">vs</span>
                    {aLogo && <img src={aLogo} alt="" class="h-7 w-7 rounded object-contain bg-slate-800 p-0.5" loading="lazy" />}
                  </span>
                )}
                <span class="font-bold text-white">{d.title}</span>
                <span class="ml-auto flex items-center gap-2">
                  <span class={`rounded px-2 py-1 text-sm font-black ${d.status === 'live' ? 'bg-rose-950 text-rose-300 animate-pulse' : 'bg-slate-800 text-cyan-300'}`}>
                    {badge[d.status]} {d.status !== 'finished' && `· ${d.eventDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}`}
                  </span>
                </span>
              </div>
              <div class="mt-2.5 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-slate-500">{d.competition}</span>
                <span class="paid flex items-center gap-1.5 rounded bg-rose-950/60 px-2 py-0.5 font-bold text-rose-300">
                  <img src={favicon('https://www.canalplus.com')} alt="" class="h-3.5 w-3.5 rounded-sm bg-white/90" />{d.paidBroadcasters[0]?.name ?? 'Canal+'}
                </span>
                {[...new Map(d.freeBroadcasters.map((b) => [new URL(b.url).hostname, b])).values()].map((b) => (
                  <span class="free flex items-center gap-1.5 rounded bg-emerald-950 px-2 py-0.5 font-bold text-emerald-300">
                    <img src={favicon(b.url)} alt="" class="h-3.5 w-3.5 rounded-sm bg-white/90" />{b.name} ({b.country})
                  </span>
                ))}
              </div>
            </a>
          ); })}
        </div>
      </>
    ))}

    <p class="mt-10 rounded-xl border border-slate-800 bg-slate-900/50 p-4 text-xs leading-relaxed text-slate-500">{SITE.disclaimer}</p>
  </section>
  <StickyVpnBar />
</BaseLayout>

<script>
  document.querySelectorAll('.pill').forEach((b) => b.addEventListener('click', () => {
    const c = b.dataset.c;
    document.querySelectorAll('.pill').forEach((x) => x.className = x.className.replace('border-cyan-500/50 bg-cyan-500/15 text-cyan-300','border-slate-700 bg-slate-900/70 text-slate-300'));
    b.className = b.className.replace('border-slate-700 bg-slate-900/70 text-slate-300','border-cyan-500/50 bg-cyan-500/15 text-cyan-300');
    document.querySelectorAll('.ev').forEach((el) => el.classList.toggle('hidden', !!c && el.dataset.comp !== c));
  }));
  document.getElementById('freeOnly')?.addEventListener('change', (e) => {
    const on = (e.target as HTMLInputElement).checked;
    document.querySelectorAll('.paid').forEach((el) => el.classList.toggle('hidden', on));
  });
</script>
